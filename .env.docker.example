# =============================================================================
# អាធិរាជរឿង (Athireach Roeung) — Docker Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NOTE: When running with Docker Compose, use service names (postgres, redis)
#       as hostnames — NOT localhost.
#
#   cp .env.docker.example .env
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (uses Docker service name "postgres") ────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://athireach:CHANGE_ME_STRONG_PASSWORD@postgres:5432/athireach_roeung

# Docker Compose will read these two vars to create the DB:
POSTGRES_USER=athireach
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis (uses Docker service name "redis") ──────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT Secrets (generate with: openssl rand -base64 64) ──────────────────────
JWT_SECRET=CHANGE_ME_REPLACE_WITH_64_CHAR_RANDOM_STRING_FOR_USER_JWT
JWT_ADMIN_SECRET=CHANGE_ME_REPLACE_WITH_64_CHAR_RANDOM_STRING_FOR_ADMIN_JWT
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=1d

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFGGHHIIJJKKLLMMNNOOPPQQRR
TELEGRAM_BOT_USERNAME=YourBotUsername

# ── Frontend URL (used for CORS and Telegram Mini App) ────────────────────────
FRONTEND_URL=https://yourdomain.com
VITE_API_URL=https://yourdomain.com/api

# ── S3 / Cloudflare R2 Storage ────────────────────────────────────────────────
# For AWS S3:   leave S3_ENDPOINT blank
# For Minio:    S3_ENDPOINT=http://minio:9000  (or your MinIO URL)
# For R2:       S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=athireach-roeung
S3_PRESIGN_EXPIRES=3600

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── First Admin Account (used by setup script) ────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_12_CHARS
ADMIN_EMAIL=admin@yourdomain.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
